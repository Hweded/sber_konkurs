# ==============================================================================
# 4. Данные (п. 9.2 Положения — запрет публикации исходных датасетов)
# ==============================================================================
data/raw/*
data/interim/*
data/processed/*
datasets/
notebooks/

# Сохраняем структуру каталогов с помощью маркеров
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Игнорируем таблицы по умолчанию
*.csv
*.xlsx
*.xls

# Исключения: файлы сабмита и реестры МО
!submission.csv
!reports/submission.csv
!configs/submission_roster.csv
!reports/artifacts/submission_roster.csv

# ==============================================================================
# 5. Обязательные артефакты жюри и воспроизводимости
# ==============================================================================
# Презентация
!presentation.pdf
!reports/presentation.pdf

# Корневые отчеты и документация
!METHODOLOGY_REPORT.md
!README.md
!metrics.json
!final_summary.json

# Артефакты в reports/artifacts/
!reports/artifacts/*.csv
!reports/artifacts/*.json
!reports/artifacts/*.md

# Исключения из reports/artifacts/ (отладочный мусор и чеки слайдов)
reports/artifacts/run.json
reports/artifacts/slide*_check.png

# Иллюстрации кейс-стади: блокируем всё, открываем только 3 утвержденных графика
reports/figures/*
!reports/figures/case_study_d9f47c0990ce.png
!reports/figures/case_study_6dd254fda2ee.png
!reports/figures/case_study_5762f61cc65c.png

# Черновики заметок в папке reports/ (при этом reports/artifacts/*.md разрешены выше)
reports/*.md