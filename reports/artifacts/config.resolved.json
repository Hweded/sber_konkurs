{
  "device": {
    "mode": "auto",
    "fallback_to_cpu_on_oom": true,
    "batch_size": 256
  },
  "ensemble": {
    "enabled": true,
    "method": "weighted_average",
    "metric_to_optimize": "MAE",
    "alpha_bounds": [
      0.5,
      1.0
    ],
    "default_alpha": 0.82,
    "prophet_weight": 0.35,
    "catboost_weight": 0.45,
    "chronos_weight": 0.2,
    "long_horizon_catboost_weight": 0.75,
    "weights_path": "configs\\candidate_oof_optimum.json"
  },
  "paths": {
    "supervised": "data\\processed\\supervised.parquet",
    "artifacts": "reports\\artifacts",
    "submission_roster": "configs\\submission_roster.csv"
  },
  "validation": {
    "n_splits": 3,
    "horizons": [
      1,
      3,
      6,
      12
    ],
    "horizon": 1,
    "fold_size": 2,
    "gap": 0,
    "min_train_periods": 6,
    "frequency": "MS",
    "time_column": "origin",
    "target_end_column": "target_end",
    "availability_column": "available_at",
    "entity_column": "region_id",
    "target_column": "target",
    "feature_columns": [
      "month",
      "quarter",
      "sin_month",
      "cos_month",
      "y_lag_1",
      "y_lag_2",
      "y_lag_3",
      "y_lag_12",
      "growth_mom",
      "growth_yoy",
      "y_rolling_mean_3",
