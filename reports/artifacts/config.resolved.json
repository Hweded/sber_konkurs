  "reproducibility": {
    "seed": 42,
    "deterministic_torch": true,
    "threads": 1
  },
  "models": {
    "prophet": {
      "growth": "linear",
      "seasonality_mode": "additive",
      "yearly_seasonality": false,
      "weekly_seasonality": false,
      "daily_seasonality": false,
      "n_changepoints": 2,
      "changepoint_prior_scale": 0.05,
      "seasonality_prior_scale": 10.0,
      "uncertainty_samples": 0
    },
    "catboost": {
      "loss_function": "MAE",
      "eval_metric": "MAE",
      "iterations": 1200,
      "depth": 6,
      "learning_rate": 0.03,
      "l2_leaf_reg": 5.0,
      "task_type": "CPU",
      "allow_writing_files": false,
      "verbose": false
    },
    "chronos": {
      "model_id": "amazon/chronos-bolt-small",
      "revision": "772f3d25d38aec6d914c8949dab4462e2d46f5d8",
      "device": "auto",
      "dtype": "float32",
      "context_length": 512,
      "prediction_length": 1,
      "point_forecast": "median",
      "zero_shot": true
    },
    "foundation_models": [
      "chronos-bolt"
    ]
  },
  "optimization": {
    "enabled": false,
    "sampler": "TPESampler",
    "n_trials": 50,
    "inner_n_splits": 3,
    "objective": "MAE"
  },
